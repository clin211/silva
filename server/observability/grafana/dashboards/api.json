    {
      "title": "业务 5xx 比例",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "silva-prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(silva_http_requests_total{job=\"silva-api\",traffic=\"application\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(silva_http_requests_total{job=\"silva-api\",traffic=\"application\"}[$__rate_interval]))",
