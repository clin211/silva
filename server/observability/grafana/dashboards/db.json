    {
      "title": "获取连接 P95",
      "type": "timeseries",
      "description": "transaction 包含 BEGIN 往返。",
      "datasource": {
        "type": "prometheus",
        "uid": "silva-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(job,operation,le)(rate(silva_db_acquire_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{job}} {{route}} {{operation}} {{queue}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "查看当前时间范围的服务日志",
