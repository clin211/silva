      "title": "连接池已使用",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "silva-prometheus"
      },
      "targets": [
        {
          "expr": "silva_db_pool_connections - silva_db_pool_idle",
          "refId": "A",
          "legendFormat": "{{job}} {{route}} {{operation}} {{queue}} {{outcome}}"
