  "panels": [
    {
      "type": "text",
      "title": "能力范围与数据口径",
      "options": {
        "mode": "markdown",
        "content": "当前 Worker 仅执行会话维护与媒体清理。外部来源采集尚未实现，空队列不代表业务链路已就绪。队列每 15 秒刷新，失败保留旧值，请先检查采集状态。采集等待时间以 started_at 或 UTC slot_date 起点估算。"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "业务状态采集成功",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "silva-prometheus"
      },
      "targets": [
        {
          "expr": "silva_business_metrics_up{job=\"silva-api\"}",
          "refId": "A",
          "legendFormat": "{{job}} {{route}} {{operation}} {{queue}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "links": [
            {
              "title": "查看当前时间范围的服务日志",
              "url": "/explore?schemaVersion=1&panes=%7B%22logs%22%3A%7B%22datasource%22%3A%22silva-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22silva-loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22silva-api%5C%22%7D%22%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D",
              "targetBlank": false
            }
          ],
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
