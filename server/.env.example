# 复制为 .env；各进程从工作目录读取该文件。
DATABASE_URL=postgres://silva:silva@127.0.0.1:55439/silva
SILVA_BIND=127.0.0.1:8088
SILVA_ENV=development
SILVA_DB_MAX_CONNECTIONS=10
# JWT（HS256）签名密钥，至少 32 字节；生产环境必须设置，可用 `openssl rand -base64 48` 生成。
# 开发环境留空时 API 启动随机生成并告警，重启后已签发的令牌全部失效。
# SILVA_JWT_SECRET=
# access token 有效期（秒），过期后用 refresh token 调用 /auth/refresh 换取新令牌。
SILVA_ACCESS_TOKEN_TTL_SECONDS=900
# refresh token 及服务端会话有效期（秒），每次刷新重新计算。
SILVA_REFRESH_TOKEN_TTL_SECONDS=604800
SILVA_WORKER_INTERVAL_SECONDS=60
SILVA_API_RATE_PER_MINUTE=600
SILVA_LOGIN_RATE_PER_MINUTE=10
# 同一邮箱 15 分钟内连续登录失败达到阈值后锁定指定秒数（进程内计数）。
SILVA_LOGIN_LOCKOUT_THRESHOLD=5
SILVA_LOGIN_LOCKOUT_SECONDS=900
RUST_LOG=info,silva_api=debug
# 以下配置仅供 CLI 初始化管理员使用；生产环境不得设置默认密码。
# SILVA_ADMIN_EMAIL=admin@example.com
# SILVA_ADMIN_NAME=Administrator
# SILVA_ADMIN_PASSWORD=

# 本地宿主机进程接入观测栈时取消下行注释；容器覆盖文件自动配置。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 根链路采样比例 0..1；远端父链路的采样决定会被继承。
OTEL_TRACES_SAMPLER_ARG=1
# Worker 独立监听指标，仅在宿主机运行时使用；容器内由覆盖文件设置。
SILVA_WORKER_METRICS_BIND=127.0.0.1:9091
# 仅本地开发默认凭据；生产使用 Secret，已有 Grafana 卷不会因修改此变量自动改密。
# GRAFANA_ADMIN_PASSWORD=
