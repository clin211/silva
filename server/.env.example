# 复制为 .env；各进程从工作目录读取该文件。
DATABASE_URL=postgres://silva:silva@127.0.0.1:55439/silva
SILVA_BIND=127.0.0.1:8088
SILVA_ENV=development
SILVA_DB_MAX_CONNECTIONS=10
# JWT（HS256）签名密钥，至少 32 字节；生产环境必须设置，可用 `openssl rand -base64 48` 生成。
# 开发环境留空时 API 启动随机生成并告警，重启后已签发的令牌全部失效。
# SILVA_JWT_SECRET=
# access token 有效期（秒），过期后用 refresh token 调用 POST /api/v1/admin/tokens 换取新令牌。
SILVA_ACCESS_TOKEN_TTL_SECONDS=900
# refresh token 及服务端会话有效期（秒），每次刷新重新计算。
SILVA_REFRESH_TOKEN_TTL_SECONDS=604800
SILVA_WORKER_INTERVAL_SECONDS=60
SILVA_API_RATE_PER_MINUTE=600
SILVA_LOGIN_RATE_PER_MINUTE=10
# 同一邮箱 15 分钟内连续登录失败达到阈值后锁定指定秒数（进程内计数）。
SILVA_LOGIN_LOCKOUT_THRESHOLD=5
SILVA_LOGIN_LOCKOUT_SECONDS=900
# 媒体私有对象存储：r2（Cloudflare R2）或 oss（阿里云 OSS）；留空时开发环境的媒体上传接口返回 503，
# 生产环境 API 拒绝启动。bucket 必须私有，并按 README「媒体存储」配置 CORS 与生命周期规则。
# SILVA_STORAGE_PROVIDER=r2
# R2：https://<account_id>.r2.cloudflarestorage.com；OSS：https://oss-cn-hangzhou.aliyuncs.com（不含 bucket）。
# SILVA_STORAGE_ENDPOINT=
# SILVA_STORAGE_BUCKET=
# R2 默认 auto；OSS 必填，为不含 oss- 前缀的地域 ID，如 cn-hangzhou（用于 V4 签名）。
# SILVA_STORAGE_REGION=auto
# bucket 内的根前缀，多个环境共用一个 bucket 时区分，如 /silva/development/；只允许 A-Z a-z 0-9 . _ -。
# SILVA_STORAGE_ROOT=/
# 访问密钥只授予该 bucket 的对象读写与删除权限；不要提交真实值。
# SILVA_STORAGE_ACCESS_KEY_ID=
# R2 使用 S3 Secret Access Key；通过 API 创建令牌时，此值为 token value 的 SHA-256 十六进制摘要。
# SILVA_STORAGE_ACCESS_KEY_SECRET=
# 图片查看链接的有效期和未完成上传的清理期限（秒），最大 86400。
SILVA_MEDIA_UPLOAD_TTL_SECONDS=900
# 公开站点构建：Worker 在该目录执行 Astro 构建（需要 Node 24 与 pnpm，并已安装前端依赖）。
# 未设置时 Worker 不处理发布任务；本机开发可指向 ../frontend/apps/website。
# SILVA_SITE_BUILDER_DIR=../frontend/apps/website
# 公开站点的完整 origin，设置 SILVA_SITE_BUILDER_DIR 时必填，用于 canonical、RSS 与 sitemap。
# SILVA_SITE_URL=http://localhost:8088
# 构建命令（按空白分隔），默认 pnpm run build；超时秒数默认 600。
# SILVA_SITE_BUILD_COMMAND="pnpm run build"
# SILVA_SITE_BUILD_TIMEOUT_SECONDS=600
# Worker 检查发布任务的间隔（秒）。
SILVA_PUBLISH_POLL_SECONDS=5
# 为 true 时 API 在 /api 之外的路径提供当前线上的静态站点。
SILVA_SITE_SERVE=false
RUST_LOG=info,silva_api=debug
# 以下配置仅供 CLI 初始化管理员使用；生产环境不得设置默认密码。
# SILVA_ADMIN_EMAIL=admin@example.com
# SILVA_ADMIN_NAME=Administrator
# SILVA_ADMIN_PASSWORD=

# 本地宿主机进程接入观测栈时取消下行注释；容器覆盖文件自动配置。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 根链路采样比例 0..1；远端父链路的采样决定会被继承。
OTEL_TRACES_SAMPLER_ARG=1
# Worker 独立监听指标，仅在宿主机运行时使用；容器内由覆盖文件设置。
SILVA_WORKER_METRICS_BIND=127.0.0.1:9091
# 仅本地开发默认凭据；生产使用 Secret，已有 Grafana 卷不会因修改此变量自动改密。
# GRAFANA_ADMIN_PASSWORD=
