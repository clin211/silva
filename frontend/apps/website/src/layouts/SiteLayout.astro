---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGeneration } from '../lib/data';
import { siteDescription, siteName, type Section } from '../lib/site';

interface Props {
    title: string;
    description?: string;
    active?: Section;
    flush?: boolean;
    type?: 'website' | 'article';
    noindex?: boolean;
    published?: string;
    updated?: string;
    structuredData?: object;
    image?: { path: string; alt: string };
}

const {
    title,
    description = siteDescription,
    active,
    flush,
    type = 'website',
    noindex = false,
    published,
    updated,
    structuredData,
    image,
} = Astro.props;
const generation = await getGeneration();
const pageTitle = `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = image && new URL(image.path, Astro.site ?? Astro.url).href;
const canIndex = Boolean(
    Astro.site && !['localhost', '127.0.0.1', '[::1]'].includes(Astro.site.hostname),
);
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#F4F8F7" />
        {generation !== undefined && <meta name="silva:generation" content={String(generation)} />}
        {(noindex || !canIndex) && <meta name="robots" content="noindex" />}
        {!noindex && <link rel="canonical" href={canonical} />}
        <link rel="alternate" type="application/rss+xml" title="Silva 文章订阅" href="/rss.xml" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonical} />}
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        {image && <meta property="og:image:alt" content={image.alt} />}
        {published && <meta property="article:published_time" content={published} />}
        {updated && <meta property="article:modified_time" content={updated} />}
        <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {imageUrl && <meta name="twitter:image" content={imageUrl} />}
        {structuredData && (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
            />
        )}
    </head>
    <body class="silva">
        <Header active={active} />
        <main id="main" tabindex="-1" class:list={{ flush }}>
            <slot />
        </main>
        <Footer />
    </body>
</html>
