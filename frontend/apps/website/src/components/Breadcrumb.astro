---
export interface BreadcrumbItem {
    href?: string;
    label: string;
}

interface Props {
    section?: { href: string; label: string };
    items?: BreadcrumbItem[];
    current: string;
}
const { section, items, current } = Astro.props;
const trail: BreadcrumbItem[] = items ?? (section ? [section] : []);
---

<nav aria-label="面包屑" class="breadcrumb t-small muted">
    <ol>
        <li>
            <a class="hover-accent" href="/">
                首页
            </a>
        </li>
        {trail.map((item) => (
            <li>
                {item.href ? (
                    <a class="hover-accent" href={item.href}>
                        {item.label}
                    </a>
                ) : (
                    <span>{item.label}</span>
                )}
            </li>
        ))}
        <li aria-current="page">{current}</li>
    </ol>
</nav>
