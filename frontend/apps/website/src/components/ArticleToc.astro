---
import type { MarkdownHeading } from 'astro';
interface Props {
    headings: MarkdownHeading[];
    mobile?: boolean;
}
const { headings, mobile } = Astro.props;
---

{headings.length >= 2 && (
    <nav aria-label={mobile ? '移动端文章目录' : '文章目录'} class="toc">
        <ul>
            {headings.map(({ depth, slug, text }) => (
                <li class:list={{ 'toc-indent': depth === 3 }}>
                    <a data-heading={slug} href={`#${slug}`}>
                        {text}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
)}
