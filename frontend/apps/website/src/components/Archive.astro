---
import { type Post } from '../lib/data';
import { categoryUrl, postUrl, seriesUrl } from '../lib/site';
import { day, monthLabel } from '../lib/format';
import Cover from './Cover.astro';
import Icon from './Icon.astro';

interface Props {
    posts: Post[];
    empty?: string;
}
const { posts, empty = '还没有发布的文章。' } = Astro.props;
const postSeriesMap = await Astro.locals.content.getPostSeriesMap();
const groups = new Map<string, Post[]>();
for (const post of posts) {
    const month = post.published.slice(0, 7);
    const group = groups.get(month);
    if (group) group.push(post);
    else groups.set(month, [post]);
}
---

{groups.size === 0 ? (
    <p class="panel empty-state ink-2">{empty}</p>
) : (
    <div class="archive">
        {[...groups].map(([month, group]) => (
            <section class="archive-month" aria-label={monthLabel(month)}>
                <h3 class="month-title num">
                    <time datetime={month}>{monthLabel(month)}</time>
                </h3>
                <ul class="archive-list rows">
                    {group.map((post) => {
                        const { slug, title, summary, published, cover, reading } = post;
                        const primary = post.categories[0];
                        const seriesCtx = postSeriesMap.get(slug);
                        return (
                            <li>
                                <article class="archive-entry">
                                    <div class="archive-copy">
                                        <div class="metadata">
                                            {primary && (
                                                <a
                                                    href={categoryUrl(primary.slug)}
                                                    class:list={['chip', primary.color]}
                                                >
                                                    {primary.name}
                                                </a>
                                            )}
                                            {seriesCtx && (
                                                <a
                                                    href={seriesUrl(seriesCtx.series.slug)}
                                                    class="chip chip-series"
                                                >
                                                    <Icon name="series" size={13} />
                                                    <span>
                                                        {seriesCtx.series.title} ·{' '}
                                                        <span class="num">
                                                            {String(seriesCtx.index).padStart(
                                                                2,
                                                                '0',
                                                            )}
                                                        </span>
                                                    </span>
                                                </a>
                                            )}
                                            <time datetime={published} class="num">
                                                {day(published)}
                                            </time>
                                            <span>{reading.minutes} 分钟阅读</span>
                                        </div>
                                        <h4 class="t-h3">
                                            <a class="hover-accent" href={postUrl(slug)}>
                                                {title}
                                            </a>
                                        </h4>
                                        <p class="ink-2">{summary}</p>
                                    </div>
                                    {cover && <Cover cover={cover} class="archive-cover" small />}
                                </article>
                            </li>
                        );
                    })}
                </ul>
            </section>
        ))}
    </div>
)}
