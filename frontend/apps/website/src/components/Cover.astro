---
import type { Cover } from '../lib/data';

interface Props {
    cover: Cover;
    label?: string;
    small?: boolean;
    class?: string;
}
const { cover, label, small, class: className } = Astro.props;
---

{cover.kind === 'image' ? (
    <img
        class:list={['cover', 'cover-image', className]}
        src={cover.src}
        width={cover.width}
        height={cover.height}
        alt={cover.alt}
        loading="lazy"
        decoding="async"
    />
) : (
    <div class:list={['cover', `c-${cover.color}`, className, { small }]} aria-hidden="true">
        {label && <span class="cover-tag">{label}</span>}
        <span class="cover-mark">{cover.mark}</span>
    </div>
)}
