---
import SiteLayout from '../layouts/SiteLayout.astro';
import Body from '../components/Body.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';

const profile = await Astro.locals.content.getProfile();
const structuredData = profile && {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    description: profile.summary,
    sameAs: profile.links.map((link) => link.url),
};
---

<SiteLayout
    title={profile ? '关于我' : '关于这个站点'}
    description={profile?.summary}
    active="about"
    {structuredData}
>
    <div class="wrap page-content">
        <PageIntro
            title={profile ? '关于我' : '关于这个站点'}
            description={
                profile?.summary ?? 'Silva 是一个记录工程实践和 AI 开源趋势的个人技术门户。'
            }
        />
        {profile && (
            <div class="about-layout">
                <aside class="about-identity" aria-label="个人档案">
                    <div class="profile-sticky">
                        {profile.avatar ? (
                            <img
                                class="profile-monogram"
                                src={profile.avatar.src}
                                width={profile.avatar.width}
                                height={profile.avatar.height}
                                alt={profile.avatar.alt}
                            />
                        ) : (
                            <span class="profile-monogram" aria-hidden="true">
                                {profile.initials}
                            </span>
                        )}
                        <h2 class="t-h3">{profile.name}</h2>
                        {profile.title && <p class="muted">{profile.title}</p>}
                        {profile.location && (
                            <p class="profile-location ink-2">
                                <Icon name="pin" size={16} />
                                {profile.location}
                            </p>
                        )}
                        {profile.links.length > 0 && (
                            <div class="actions">
                                {profile.links.map(({ label, url }) => (
                                    <a class="btn btn-ghost btn-sm" href={url}>
                                        {label}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                </aside>
                <div class="about-body">
                    {profile.bio && (
                        <section aria-labelledby="bio-title">
                            <h2 id="bio-title" class="t-h2">
                                个人简介
                            </h2>
                            <div class="prose">
                                <Body body={profile.bio} />
                            </div>
                        </section>
                    )}
                    {profile.experience.length > 0 && (
                        <section aria-labelledby="work-title">
                            <h2 id="work-title" class="t-h2">
                                工作经历
                            </h2>
                            <ol class="rows jobs">
                                {profile.experience.map(
                                    ({ period, role, organization, descriptionHtml }) => (
                                        <li>
                                            <p class="num t-small muted">{period}</p>
                                            <div>
                                                <h3 class="t-h3">{role}</h3>
                                                {organization && (
                                                    <p class="t-small muted">{organization}</p>
                                                )}
                                                {descriptionHtml && (
                                                    <div class="ink-2" set:html={descriptionHtml} />
                                                )}
                                            </div>
                                        </li>
                                    ),
                                )}
                            </ol>
                        </section>
                    )}
                    {profile.skills.length > 0 && (
                        <section aria-labelledby="skill-title">
                            <h2 id="skill-title" class="t-h2">
                                技术能力
                            </h2>
                            <div class="skills-grid">
                                {profile.skills.map(({ group, items }) => (
                                    <div class="panel">
                                        <h3 class="t-h3">{group}</h3>
                                        <ul class="chips">
                                            {items.map((item) => (
                                                <li class="chip">{item}</li>
                                            ))}
                                        </ul>
                                    </div>
                                ))}
                            </div>
                        </section>
                    )}
                </div>
            </div>
        )}
    </div>
    <section class="band band-sun" aria-labelledby="contact-title">
        <div class="wrap">
            <h2 id="contact-title" class="t-h1">
                {profile?.links.length ? '保持联系' : '继续阅读'}
            </h2>
            <div class="actions">
                {profile?.links.map(({ label, url }) => (
                    <a class="btn btn-dark" href={url}>
                        {label}
                    </a>
                ))}
                <a class="btn btn-ghost" href="/series/">
                    浏览博客
                </a>
            </div>
        </div>
    </section>
</SiteLayout>
