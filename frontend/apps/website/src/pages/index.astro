---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Cover from '../components/Cover.astro';

import type { Sample, WindowDays } from '../lib/trending';
import {
    categoryUrl,
    postUrl,
    repoUrl,
    seriesDomainUrl,
    seriesUrl,
    siteDescription,
    tagUrl,
} from '../lib/site';
import { day, growth, growthClass, number } from '../lib/format';
import { defaultFilters, rank } from '../lib/ranking';

const [profile, posts, seriesList, postSeriesMap, categories, tags, trending, generation] =
    await Promise.all([
        Astro.locals.content.getProfile(),
        Astro.locals.content.listPosts(),
        Astro.locals.content.listSeries(),
        Astro.locals.content.getPostSeriesMap(),
        Astro.locals.content.listCategories(),
        Astro.locals.content.listTags(),
        Astro.locals.content.getTrending(),
        Astro.locals.content.getGeneration(),
    ]);

const pad = (value: number) => String(value).padStart(2, '0');

const formatCompactCount = (value: number) => {
    if (value >= 10000) return `${(value / 10000).toFixed(1)} 万`;
    if (value >= 1000) return `${(value / 1000).toFixed(1)}k`;
    return String(value);
};

const formatStars = (value: number) =>
    value >= 1000 ? `${(value / 1000).toFixed(1)}k` : String(value);

// Band 02: Knowledge Atlas (Domain Bento + Topic Atlas)
const totalWords = posts.reduce((sum, post) => sum + post.reading.count, 0);
const totalReadingMinutes = posts.reduce((sum, post) => sum + post.reading.minutes, 0);
const latestPublishedDate = posts[0] ? day(posts[0].published) : undefined;

const domainIconFor = (slug: string) => {
    switch (slug) {
        case 'backend':
            return 'server' as const;
        case 'ai-engineering':
            return 'spark' as const;
        case 'frontend':
            return 'code' as const;
        case 'devops':
            return 'layers' as const;
        case 'cross-platform':
            return 'mobile' as const;
        case 'notes':
            return 'book' as const;
        default:
            return 'folder' as const;
    }
};

const domainToneFor = (color?: string) => {
    switch (color) {
        case 'chip-coral':
            return 'coral';
        case 'chip-sun':
            return 'sun';
        case 'chip-indigo':
            return 'indigo';
        case 'chip-done':
            return 'done';
        default:
            return 'teal';
    }
};

const domainCards = categories
    .map((cat) => {
        const catSeries = seriesList.filter((item) => item.category?.slug === cat.slug);
        const catPosts = posts.filter((post) => post.categories.some((c) => c.slug === cat.slug));
        return {
            category: cat,
            seriesCount: catSeries.length,
            postCount: catPosts.length,
            latestPost: catPosts[0],
            icon: domainIconFor(cat.slug),
            tone: domainToneFor(cat.color),
            href: catSeries.length > 0 ? seriesDomainUrl(cat.slug) : categoryUrl(cat.slug),
        };
    })
    .filter((item) => item.seriesCount > 0 || item.postCount > 0)
    .sort(
        (a, b) =>
            b.seriesCount - a.seriesCount ||
            b.postCount - a.postCount ||
            a.category.name.localeCompare(b.category.name, 'zh-CN'),
    );

const tagPostCount = new Map<string, number>();
for (const post of posts) {
    for (const tag of post.tags) {
        tagPostCount.set(tag.slug, (tagPostCount.get(tag.slug) ?? 0) + 1);
    }
}
const topicTags = tags
    .map((tag) => ({ ...tag, count: tagPostCount.get(tag.slug) ?? 0 }))
    .filter((tag) => tag.count > 0)
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'))
    .slice(0, 12);

const hasDomainsSection = domainCards.length > 0 || topicTags.length > 0;
const featuredDomainCount = domainCards.length >= 4 ? 2 : 0;

// Band 03: Curated Series Bookshelf
const orderedSeries = [
    ...seriesList.filter((item) => item.featured),
    ...seriesList.filter((item) => !item.featured),
];
const leadSeries = orderedSeries[0];
const secondarySeries = orderedSeries.slice(1, 4);
const hasSeriesSection = Boolean(leadSeries);

// Band 04: Latest Writing + Monthly Writing Cadence
const primary = posts.find((post) => post.featured) ?? posts[0];
const primarySeries = primary ? postSeriesMap.get(primary.slug) : undefined;
const recent = posts.filter((post) => post !== primary).slice(0, 4);

const monthlyMap = new Map<string, number>();
for (const post of posts) {
    const key = post.published.slice(0, 7);
    monthlyMap.set(key, (monthlyMap.get(key) ?? 0) + 1);
}
const monthlyActivity = [...monthlyMap.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .slice(-6)
    .map(([key, count]) => ({
        key,
        shortMonth: key.slice(5, 7),
        count,
    }));
const maxMonthlyCount = Math.max(1, ...monthlyActivity.map((item) => item.count));

// Band 05: AI Open-Source Observatory (7d & 30d Windows + Server-Rendered Sparkline)
const languageColor = (lang: string) => {
    switch (lang.toLowerCase()) {
        case 'typescript':
            return '#3178c6';
        case 'python':
            return '#4b8bbe';
        case 'rust':
            return '#dea584';
        case 'go':
            return '#00add8';
        case 'c++':
            return '#f34b7d';
        default:
            return '#5ed6cc';
    }
};

function buildSparkline(samples: Sample[]) {
    if (samples.length < 2) return undefined;
    const recentSamples = samples.slice(-24);
    const values = recentSamples.map((s) => s.stars);
    const min = Math.min(...values);
    const max = Math.max(...values);
    const range = Math.max(1, max - min);
    const width = 280;
    const height = 56;
    const padY = 6;
    const points = recentSamples.map((sample, index) => {
        const x = (index / (recentSamples.length - 1)) * width;
        const y = height - padY - ((sample.stars - min) / range) * (height - padY * 2);
        return { x: Number(x.toFixed(1)), y: Number(y.toFixed(1)) };
    });
    const line = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y}`).join(' ');
    const area = `${line} L${width},${height} L0,${height} Z`;
    const last = points[points.length - 1]!;
    return { line, area, last };
}

const top7 = trending ? rank(trending.repos, { ...defaultFilters, window: 7 }).slice(0, 5) : [];
const top30 = trending ? rank(trending.repos, { ...defaultFilters, window: 30 }).slice(0, 5) : [];

const [spark7Samples, spark30Samples] = await Promise.all([
    top7[0] ? Astro.locals.content.getRepositoryHistory(top7[0].slug) : Promise.resolve([]),
    top30[0] ? Astro.locals.content.getRepositoryHistory(top30[0].slug) : Promise.resolve([]),
]);

const trendWindows: {
    days: WindowDays;
    label: string;
    repos: typeof top7;
    maxGrowth: number;
    sparkline: ReturnType<typeof buildSparkline>;
}[] = trending
    ? [
          {
              days: 7,
              label: '近 7 天',
              repos: top7,
              maxGrowth: Math.max(1, ...top7.map((r) => Math.max(0, r.growth.stars[7] ?? 0))),
              sparkline: buildSparkline(spark7Samples),
          },
          {
              days: 30,
              label: '近 30 天',
              repos: top30,
              maxGrowth: Math.max(1, ...top30.map((r) => Math.max(0, r.growth.stars[30] ?? 0))),
              sparkline: buildSparkline(spark30Samples),
          },
      ]
    : [];

const ecosystemBreakdown = trending
    ? [
          ...trending.repos.reduce((acc, repo) => {
              acc.set(repo.category, (acc.get(repo.category) ?? 0) + 1);
              return acc;
          }, new Map<string, number>()),
      ]
          .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'))
          .map(([name, count]) => ({ name, count }))
    : [];

// Hero Snapshot Stats
const stats = [
    { label: '专栏', value: seriesList.length },
    { label: '文章', value: posts.length },
    { label: '分类', value: categories.length },
    { label: '榜单收录', value: trending?.repos.length ?? '—' },
];

// Band alternation helpers so neighboring bands always have clear visual rhythm
const recentBandClass = hasSeriesSection ? 'band' : hasDomainsSection ? 'band band-mist' : 'band';
---

<SiteLayout title={profile?.name ?? '首页'} active="home" flush>
    <!-- ================================================================ -->
    <!-- BAND 01 · HERO（保留深青玻璃风格 · 层叠远山与林间晨光）           -->
    <!-- ================================================================ -->
    <section class="hero band-teal" aria-labelledby="hero-title">
        <div class="hero-canopy" aria-hidden="true">
            <div class="hero-canopy-sky"></div>
            <div class="hero-ray hero-ray-primary"></div>
            <div class="hero-ray hero-ray-secondary"></div>

            <!-- Layered misty mountains: valley rebounding into higher peaks -->
            <svg class="hero-ridges" viewBox="0 0 1440 520" preserveAspectRatio="none" fill="none">
                <defs>
                    <linearGradient id="ridgeFarGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0b6e78" stop-opacity="0.58" />
                        <stop offset="100%" stop-color="#054249" stop-opacity="0.72" />
                    </linearGradient>
                    <linearGradient id="ridgeMidGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#06535c" stop-opacity="0.78" />
                        <stop offset="100%" stop-color="#04373e" stop-opacity="0.88" />
                    </linearGradient>
                    <linearGradient id="ridgeNearGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#043b42" stop-opacity="0.9" />
                        <stop offset="100%" stop-color="#03262b" stop-opacity="0.96" />
                    </linearGradient>
                </defs>
                <!-- Far peaks & dawn mist crest -->
                <path
                    class="hero-ridge hero-ridge-far"
                    d="M0,335 C120,285 215,345 355,275 C495,205 585,295 735,215 C885,135 1005,210 1165,122 C1270,66 1355,95 1440,68 L1440,520 L0,520 Z"
                    fill="url(#ridgeFarGrad)"
                />
                <!-- Subtle sunlit rim highlight along the far ascending peaks -->
                <path
                    class="hero-ridge hero-ridge-far"
                    d="M355,275 C495,205 585,295 735,215 C885,135 1005,210 1165,122 C1270,66 1355,95 1440,68"
                    stroke="#9ee8df"
                    stroke-width="1.25"
                    stroke-opacity="0.28"
                />
                <!-- Mid ridge: dip into valley, rebound stronger -->
                <path
                    class="hero-ridge hero-ridge-mid"
                    d="M0,390 C165,340 285,395 450,330 C615,265 735,340 915,248 C1085,162 1235,230 1440,158 L1440,520 L0,520 Z"
                    fill="url(#ridgeMidGrad)"
                />
                <!-- Near forested silhouette -->
                <path
                    class="hero-ridge hero-ridge-near"
                    d="M0,438 C210,402 395,436 620,382 C845,328 1030,378 1245,314 C1335,288 1392,298 1440,284 L1440,520 L0,520 Z"
                    fill="url(#ridgeNearGrad)"
                />
            </svg>

            <!-- Gentle rising dawn motes in the open right sky -->
            <svg
                class="hero-motes"
                viewBox="0 0 1200 600"
                preserveAspectRatio="xMidYMid slice"
                fill="none"
            >
                <circle class="hero-mote hero-mote-a" cx="760" cy="240" r="2.2" fill="#f8da78" />
                <circle class="hero-mote hero-mote-b" cx="890" cy="175" r="1.8" fill="#d4f7f3" />
                <circle class="hero-mote hero-mote-c" cx="1010" cy="255" r="2.4" fill="#f8da78" />
                <circle class="hero-mote hero-mote-d" cx="695" cy="305" r="1.6" fill="#d4f7f3" />
                <circle class="hero-mote hero-mote-e" cx="1105" cy="145" r="2" fill="#5ed6cc" />
            </svg>
        </div>

        <div class="hero-shade" aria-hidden="true"></div>
        <div class="wrap hero-grid">
            <div class="hero-content">
                {profile && (
                    <p class="hero-kicker">
                        {profile.location && (
                            <>
                                <Icon name="pin" size={16} />
                                {profile.location}
                                <span aria-hidden="true">·</span>
                            </>
                        )}
                        {profile.title}
                    </p>
                )}
                <h1 id="hero-title" class="t-hero">
                    {profile?.name ?? 'Silva'}
                </h1>
                <p class="hero-line">
                    {profile ? '记录技术，写下实践。' : '一个持续更新的个人技术门户。'}
                </p>
                <p class="hero-description t-lead">
                    {profile
                        ? '这里记录工程实践、学习笔记，以及对 AI 开源生态的观察。'
                        : siteDescription}
                </p>
                <div class="actions">
                    <a href="/series/" class="btn btn-light">
                        浏览博客
                    </a>
                    <a href="/about/" class="btn btn-ghost">
                        {profile ? '关于长林' : '关于本站'}
                    </a>
                </div>
            </div>
            <aside class="hero-snapshot" aria-labelledby="snapshot-title">
                <div class="snapshot-surface">
                    <header>
                        <h2 id="snapshot-title">站点快照</h2>
                        <span class="snapshot-label mono">第 {generation} 版</span>
                    </header>
                    <dl>
                        {stats.map(({ label, value }) => (
                            <div>
                                <dt>{label}</dt>
                                <dd class="num">{value}</dd>
                            </div>
                        ))}
                    </dl>
                    {top7[0] && (
                        <a href={repoUrl(top7[0].slug)} class="snapshot-leader">
                            <span>
                                <small>近 7 天 Stars 增长最快</small>
                                <strong>{top7[0].name}</strong>
                            </span>
                            <span class="mono">{growth(top7[0].growth.stars[7])}</span>
                        </a>
                    )}
                </div>
            </aside>
        </div>
    </section>

    <!-- ================================================================ -->
    <!-- BAND 02 · 知识版图 BENTO + 热门主题标签带                         -->
    <!-- ================================================================ -->
    {hasDomainsSection && (
        <section class="band" aria-labelledby="home-knowledge-title">
            <div class="wrap">
                <header class="section-heading home-band-head">
                    <div>
                        <span class="eyebrow">知识版图 · Knowledge Atlas</span>
                        <h2 id="home-knowledge-title" class="t-h1 home-band-title">
                            按领域探索
                        </h2>
                        <p class="t-small muted home-section-sub">
                            选择感兴趣的技术领域，直接进入对应专栏书架或分类归档。
                        </p>
                    </div>
                    {posts.length > 0 && (
                        <div class="panel home-pulse-pill t-xs" aria-label="站点内容体量统计">
                            <span class="muted">内容体量</span>
                            <strong class="mono num">{formatCompactCount(totalWords)}字</strong>
                            <span class="pulse-sep" aria-hidden="true">
                                |
                            </span>
                            <strong class="mono num">约 {totalReadingMinutes} 分钟阅读</strong>
                            {latestPublishedDate && (
                                <>
                                    <span class="pulse-sep" aria-hidden="true">
                                        |
                                    </span>
                                    <span class="mono num pulse-accent">
                                        更新于 {latestPublishedDate}
                                    </span>
                                </>
                            )}
                        </div>
                    )}
                </header>

                {domainCards.length > 0 && (
                    <ul class="domain-bento">
                        {domainCards.map(
                            (
                                { category, seriesCount, postCount, latestPost, icon, tone, href },
                                idx,
                            ) => {
                                const isFeatured = idx < featuredDomainCount;
                                return (
                                    <li class:list={{ 'is-featured': isFeatured }}>
                                        <a
                                            class:list={[
                                                'panel',
                                                'lift',
                                                'domain-bento-card',
                                                `tone-${tone}`,
                                                { 'is-featured': isFeatured },
                                            ]}
                                            href={href}
                                        >
                                            <div class="domain-bento-top">
                                                <div class="domain-bento-ident">
                                                    <span
                                                        class:list={[
                                                            'domain-icon-box',
                                                            `tone-${tone}`,
                                                        ]}
                                                        aria-hidden="true"
                                                    >
                                                        <Icon
                                                            name={icon}
                                                            size={isFeatured ? 20 : 17}
                                                        />
                                                    </span>
                                                    <div>
                                                        {isFeatured && (
                                                            <span
                                                                class:list={[
                                                                    'domain-role-badge',
                                                                    `tone-${tone}`,
                                                                ]}
                                                            >
                                                                {idx === 0
                                                                    ? '核心领域'
                                                                    : '重点方向'}
                                                            </span>
                                                        )}
                                                        <h3 class="domain-bento-title hover-accent">
                                                            {category.name}
                                                        </h3>
                                                    </div>
                                                </div>
                                                <span
                                                    class="domain-card-arrow arrow muted"
                                                    aria-hidden="true"
                                                >
                                                    ↗
                                                </span>
                                            </div>
                                            {category.description && (
                                                <p class="domain-card-desc t-small ink-2">
                                                    {category.description}
                                                </p>
                                            )}
                                            <div class="domain-bento-foot t-xs">
                                                {isFeatured && latestPost && (
                                                    <span class="domain-latest muted">
                                                        最新：<strong>{latestPost.title}</strong>
                                                    </span>
                                                )}
                                                <span class="domain-card-stat mono num">
                                                    {seriesCount > 0 && (
                                                        <span>{seriesCount} 专栏</span>
                                                    )}
                                                    {seriesCount > 0 && postCount > 0 && (
                                                        <span aria-hidden="true">·</span>
                                                    )}
                                                    {postCount > 0 && <span>{postCount} 篇</span>}
                                                </span>
                                            </div>
                                        </a>
                                    </li>
                                );
                            },
                        )}
                    </ul>
                )}

                {topicTags.length > 0 && (
                    <nav class="panel home-topic-atlas" aria-label="热门主题标签">
                        <span class="topic-atlas-label t-xs muted">热门主题标签</span>
                        <ul class="chips">
                            {topicTags.map((tag, index) => (
                                <li>
                                    <a
                                        href={tagUrl(tag.slug)}
                                        class:list={['chip', 'hash', { 'chip-teal': index === 0 }]}
                                    >
                                        <span>{tag.name}</span>
                                        <span class="topic-count mono num">{tag.count}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                )}
            </div>
        </section>
    )}

    <!-- ================================================================ -->
    <!-- BAND 03 · 精选专栏书架（7:5 主次书架 + 章节路线直达）              -->
    <!-- ================================================================ -->
    {hasSeriesSection && leadSeries && (
        <section class="band band-mist" aria-labelledby="home-series-title">
            <div class="wrap">
                <header class="section-heading home-band-head">
                    <div>
                        <span class="eyebrow">系统阅读 · Curated Series</span>
                        <h2 id="home-series-title" class="t-h1 home-band-title">
                            精选专栏书架
                        </h2>
                    </div>
                    <a class="btn btn-ghost btn-sm" href="/series/">
                        进入完整书架
                        <Icon name="arrowRight" size={14} />
                    </a>
                </header>

                <div
                    class:list={[
                        'series-shelf-grid',
                        { 'is-single': secondarySeries.length === 0 },
                    ]}
                >
                    <!-- Primary Lead Series Double-Bezel Spotlight Card -->
                    <article class="bezel lift series-spotlight">
                        <div class="face series-spotlight-face">
                            <div class="series-spotlight-cover-wrap">
                                <Cover
                                    cover={leadSeries.cover}
                                    label={leadSeries.category?.name}
                                    class="series-spotlight-cover"
                                />
                                <div class="series-spotlight-badges">
                                    {leadSeries.featured && (
                                        <span class="chip chip-sun">精选专栏</span>
                                    )}
                                    <span
                                        class:list={[
                                            'chip',
                                            leadSeries.completionStatus === 'completed'
                                                ? 'chip-done'
                                                : 'chip-teal',
                                        ]}
                                    >
                                        {leadSeries.completionStatus === 'completed'
                                            ? '已完结'
                                            : '连载中'}
                                    </span>
                                </div>
                            </div>
                            <div class="series-spotlight-body">
                                <div>
                                    <div class="metadata t-xs">
                                        {leadSeries.category && (
                                            <a
                                                class:list={[
                                                    'chip',
                                                    leadSeries.category.color ?? 'chip-teal',
                                                ]}
                                                href={categoryUrl(leadSeries.category.slug)}
                                            >
                                                {leadSeries.category.name}
                                            </a>
                                        )}
                                        <span class="mono num">
                                            {leadSeries.postCount} 篇 · {leadSeries.totalMinutes}{' '}
                                            分钟
                                        </span>
                                    </div>
                                    <h3 class="t-h2 series-spotlight-title">
                                        <a class="hover-accent" href={seriesUrl(leadSeries.slug)}>
                                            {leadSeries.title}
                                        </a>
                                    </h3>
                                    {leadSeries.description && (
                                        <p class="t-small ink-2 series-spotlight-desc">
                                            {leadSeries.description}
                                        </p>
                                    )}
                                    {leadSeries.entries.length > 0 && (
                                        <ol class="rows series-roadmap">
                                            {leadSeries.entries.slice(0, 3).map((entry) => (
                                                <li>
                                                    <a
                                                        class="series-roadmap-link"
                                                        href={postUrl(entry.post.slug)}
                                                    >
                                                        <span class="mono num series-roadmap-idx">
                                                            {pad(entry.index)}
                                                        </span>
                                                        <span class="series-roadmap-title hover-accent">
                                                            {entry.displayTitle}
                                                        </span>
                                                        <span class="mono num t-xs muted">
                                                            {entry.post.reading.minutes} min ↗
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ol>
                                    )}
                                </div>
                                <div class="series-spotlight-foot">
                                    <span class="mono num t-xs muted">
                                        更新于 {day(leadSeries.updated)}
                                    </span>
                                    <a
                                        class="btn btn-dark btn-sm"
                                        href={
                                            leadSeries.entries[0]
                                                ? postUrl(leadSeries.entries[0].post.slug)
                                                : seriesUrl(leadSeries.slug)
                                        }
                                    >
                                        从第一章开始读
                                        <Icon name="arrowRight" size={14} />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>

                    <!-- Secondary Series Column -->
                    {secondarySeries.length > 0 && (
                        <div class="series-secondary-col">
                            {secondarySeries.map((item) => {
                                const isCompleted = item.completionStatus === 'completed';
                                return (
                                    <article class="panel lift series-compact-card">
                                        <div class="series-compact-head">
                                            <a
                                                href={seriesUrl(item.slug)}
                                                class="series-compact-cover-link"
                                                aria-hidden="true"
                                                tabindex="-1"
                                            >
                                                <Cover
                                                    cover={item.cover}
                                                    small
                                                    class="r-md series-compact-cover"
                                                />
                                            </a>
                                            <div class="series-compact-meta">
                                                <div class="series-compact-tags t-xs">
                                                    <span
                                                        class:list={[
                                                            'chip',
                                                            isCompleted ? 'chip-done' : 'chip-teal',
                                                        ]}
                                                    >
                                                        {isCompleted ? '已完结' : '连载中'}
                                                    </span>
                                                    {item.category && (
                                                        <span class="muted">
                                                            {item.category.name}
