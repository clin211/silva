                <p class="t-small home-closing-copy">
                    {profile?.links.length
                        ? '如果你对全栈架构、AI 应用工程化或内容系统构建感兴趣，欢迎通过以下渠道交流，或直接订阅本站更新。'
                        : '所有新发布的文章与专栏更新都会同步输出到 RSS 源，无算法推送干扰。'}
                </p>
                {profile && profile.links.length > 0 && (
                    <div class="actions">
                        {profile.links.map(({ label, url }) => (
                            <a
                                class="btn btn-dark"
                                href={url}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span>{label}</span>
                                <span class="arrow" aria-hidden="true">
                                    ↗
                                </span>
                            </a>
                        ))}
                    </div>
                )}
            </div>

            <div class="closing-rss-card">
                <div class="closing-rss-head">
                    <span class="closing-rss-title">
                        <Icon name="rss" size={17} />
                        <strong>通过 RSS 订阅新文章</strong>
                    </span>
                    <span class="closing-rss-badge t-xs">无算法推送</span>
                </div>
                <p class="t-xs closing-rss-desc">
                    支持任意 RSS 阅读器，每篇新发布文章自动同步，不收集邮箱。
                </p>
                <div class="closing-rss-bar">
                    <code class="mono closing-rss-url">/rss.xml</code>
                    <button
                        type="button"
                        class="btn btn-dark btn-sm"
                        data-copy-rss
                        aria-label="复制 RSS 订阅地址"
                    >
                        <Icon name="copy" size={14} />
                        <span data-copy-rss-label>复制地址</span>
                    </button>
                    <a class="btn btn-ghost btn-sm" href="/rss.xml">
                        打开
                    </a>
                </div>
                <span class="sr-only" role="status" aria-live="polite" data-copy-rss-status />
                <nav class="closing-quick-nav t-xs" aria-label="快捷入口">
                    <a href="/series/">专栏书架 →</a>
                    <a href="/blog/">全部归档 →</a>
                    <a href="/ai-trending/">AI 趋势榜 →</a>
                    <a href="/about/">关于本站 →</a>
                </nav>
            </div>
        </div>
    </section>
</SiteLayout>
<script>
    // Subtle layered mountain parallax in Hero (respects prefers-reduced-motion)
    const canopy = document.querySelector<HTMLElement>('.hero-canopy');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if (canopy && !reduced.matches) {
        const hero = canopy.closest('.hero');
        let frame = 0;
        window.addEventListener(
            'scroll',
            () => {
                if (frame) return;
                frame = requestAnimationFrame(() => {
                    const limit = (hero?.clientHeight ?? 600) * 0.1;
                    const y = reduced.matches ? 0 : Math.min(limit, Math.max(0, window.scrollY));
                    canopy.style.setProperty('--ridge-far-y', `${(y * 0.16).toFixed(1)}px`);
                    canopy.style.setProperty('--ridge-mid-y', `${(y * 0.08).toFixed(1)}px`);
                    frame = 0;
                });
            },
            { passive: true },
        );
    }

    // Progressive enhancement: 7d / 30d switcher in AI Open-Source Observatory
    const trendButtons = document.querySelectorAll<HTMLButtonElement>('[data-trend-trigger]');
    const trendPanels = document.querySelectorAll<HTMLElement>('[data-trend-panel]');
    if (trendButtons.length > 0 && trendPanels.length > 0) {
        for (const button of trendButtons) {
            button.addEventListener('click', () => {
                const target = button.dataset.trendTrigger;
                for (const btn of trendButtons) {
                    btn.setAttribute('aria-pressed', String(btn.dataset.trendTrigger === target));
                }
                for (const panel of trendPanels) {
                    panel.hidden = panel.dataset.trendPanel !== target;
                }
            });
        }
    }

    // Progressive enhancement: One-click copy RSS URL with accessible status feedback
    const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-rss]');
    const copyLabel = document.querySelector<HTMLElement>('[data-copy-rss-label]');
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-rss-status]');
    if (copyBtn && copyLabel) {
        let resetTimer = 0;
        copyBtn.addEventListener('click', async () => {
            const rssHref = new URL('/rss.xml', window.location.origin).href;
            try {
                await navigator.clipboard.writeText(rssHref);
                copyLabel.textContent = '已复制';
                if (copyStatus) copyStatus.textContent = '已复制 RSS 订阅地址到剪贴板';
            } catch {
                copyLabel.textContent = '/rss.xml';
                if (copyStatus) copyStatus.textContent = `RSS 地址为 ${rssHref}`;
            }
            window.clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => {
                copyLabel.textContent = '复制地址';
            }, 1800);
        });
    }
</script>
