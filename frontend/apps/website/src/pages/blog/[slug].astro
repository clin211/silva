---
import { siteOrigin } from '../../lib/origin';
import ArticleToc from '../../components/ArticleToc.astro';
import Body from '../../components/Body.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Cover from '../../components/Cover.astro';
import Icon from '../../components/Icon.astro';
import SeriesOutline from '../../components/SeriesOutline.astro';
import ShareDialog from '../../components/ShareDialog.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { day, number } from '../../lib/format';
import { categoryUrl, postUrl, seriesUrl, tagUrl } from '../../lib/site';

const posts = await Astro.locals.content.listPosts();
const index = posts.findIndex((item) => item.slug === Astro.params.slug);
const post = posts[index];
if (!post) return Astro.rewrite('/404');
const newer = posts[index - 1];
const older = posts[index + 1];
const { title, summary, published, updated, tags, cover } = post;
const category = post.categories[0];
const description = post.seoDescription ?? summary;
const [profile, postSeriesMap] = await Promise.all([
    Astro.locals.content.getProfile(),
    Astro.locals.content.getPostSeriesMap(),
]);
const seriesContext = postSeriesMap.get(post.slug);
const headings = post.headings.filter(({ depth }) => depth === 2 || depth === 3);
const { count, minutes } = post.reading;
const padIndex = (value: number) => String(value).padStart(2, '0');
const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: published,
    dateModified: updated ?? published,
    mainEntityOfPage: new URL(postUrl(post.slug), siteOrigin(Astro)).href,
    author: profile && { '@type': 'Person', name: profile.name },
};
---

<SiteLayout
    title={post.seoTitle ?? title}
    {description}
    active="blog"
    type="article"
    {published}
    {updated}
    {structuredData}
    image={cover?.kind === 'image' ? { path: cover.src, alt: cover.alt } : undefined}
>
    <div class="wrap article-page">
        <Breadcrumb
            items={
                seriesContext
                    ? [
                          { href: '/series/', label: '博客' },
                          {
                              href: seriesUrl(seriesContext.series.slug),
                              label: seriesContext.series.title,
                          },
                      ]
                    : [
                          { href: '/series/', label: '博客' },
                          { href: '/blog/', label: '全部文章' },
                      ]
            }
            current={title}
        />
        <article>
            <header class="article-header">
                {category && (
                    <a href={categoryUrl(category.slug)} class:list={['chip', category.color]}>
                        {category.name}
                    </a>
                )}
                <h1>{title}</h1>
                {seriesContext && (
                    <a class="series-banner" href={seriesUrl(seriesContext.series.slug)}>
                        <span class="series-banner-main">
                            <Icon name="series" size={16} />
                            <span>
                                系列：<strong>《{seriesContext.series.title}》</strong>
                                {seriesContext.entry.sectionTitle && (
                                    <span class="muted"> · {seriesContext.entry.sectionTitle}</span>
                                )}
                            </span>
                        </span>
                        <span class="series-banner-progress mono num">
                            第 {seriesContext.index} / {seriesContext.total} 篇
                        </span>
                    </a>
                )}
                <div class="article-meta">
                    <div class="metadata">
                        {profile && (
                            <a class="hover-accent" href="/about/">
                                {profile.name}
                            </a>
                        )}
                        <span>
                            发布于{' '}
                            <time datetime={published} class="num">
                                {day(published)}
                            </time>
                        </span>
                        {updated && (
                            <span>
                                更新于{' '}
                                <time datetime={updated} class="num">
                                    {day(updated)}
                                </time>
                            </span>
                        )}
                        <span class="article-reading">
                            <Icon name="clock" size={14} />
                            {minutes} 分钟阅读
                        </span>
                        <span>{number(count)} 字</span>
                        {tags.length > 0 && (
                            <ul class="chips" aria-label="文章标签">
                                {tags.map(({ slug, name }) => (
                                    <li>
                                        <a href={tagUrl(slug)} class="chip hash">
                                            {name}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                    <button
                        type="button"
                        hidden
                        class="btn btn-ghost btn-sm"
                        data-share-open
                        aria-haspopup="dialog"
                        aria-controls="share-dialog"
                    >
                        <Icon name="share" size={16} />
                        分享
                    </button>
                </div>
                <p class="article-summary t-lead ink-2">{summary}</p>
                {cover && <Cover cover={cover} label={category?.name} class="article-cover" />}
            </header>

            <div class="reading-layout">
                <div class="reading-main">
                    {seriesContext && (
                        <details class="panel toc-mobile series-outline-mobile">
                            <summary>
                                系列目录（第 {seriesContext.index} / {seriesContext.total} 篇）
                            </summary>
                            <SeriesOutline
                                series={seriesContext.series}
                                currentSlug={post.slug}
                                mobile
                            />
                        </details>
                    )}
                    {headings.length >= 2 && (
                        <details class="panel toc-mobile">
                            <summary>文章目录</summary>
                            <ArticleToc {headings} mobile />
                        </details>
                    )}
                    <div class="prose article-body">
                        <Body body={post.body} />
                    </div>
                    <div class="article-actions">
                        {seriesContext ? (
                            <>
                                <a
                                    class="btn btn-ghost btn-sm"
                                    href={seriesUrl(seriesContext.series.slug)}
                                >
                                    返回专栏目录
                                </a>
                                <a class="btn btn-ghost btn-sm" href="/series/">
                                    全部专栏
                                </a>
                            </>
                        ) : (
                            <>
                                <a class="btn btn-ghost btn-sm" href="/series/">
                                    返回博客
                                </a>
                                <a class="btn btn-ghost btn-sm" href="/blog/">
                                    全部文章归档
                                </a>
                            </>
                        )}
                        <button
                            type="button"
                            hidden
                            class="btn btn-dark btn-sm"
                            data-share-open
                            aria-haspopup="dialog"
                            aria-controls="share-dialog"
                        >
                            <Icon name="share" size={16} />
                            分享这篇文章
                        </button>
                    </div>
                    {seriesContext ? (
                        <nav aria-label="系列内相邻文章" class="article-neighbors">
                            {seriesContext.prev ? (
                                <a
                                    href={postUrl(seriesContext.prev.post.slug)}
                                    class="hover-accent"
                                >
                                    <span class="muted">系列上一篇</span>
                                    <span>
                                        <span class="mono num">
                                            {padIndex(seriesContext.prev.index)}
                                        </span>{' '}
                                        {seriesContext.prev.displayTitle}
                                    </span>
                                </a>
                            ) : (
                                <span aria-hidden="true"></span>
                            )}
                            {seriesContext.next ? (
                                <a
                                    href={postUrl(seriesContext.next.post.slug)}
                                    class="hover-accent article-neighbor-next"
                                >
                                    <span class="muted">系列下一篇</span>
                                    <span>
                                        <span class="mono num">
                                            {padIndex(seriesContext.next.index)}
                                        </span>{' '}
                                        {seriesContext.next.displayTitle}
                                    </span>
                                </a>
                            ) : (
                                <a
                                    href={seriesUrl(seriesContext.series.slug)}
                                    class="hover-accent article-neighbor-next"
                                >
                                    <span class="muted">返回系列目录</span>
                                    <span>《{seriesContext.series.title}》</span>
                                </a>
                            )}
                        </nav>
                    ) : (
                        (newer || older) && (
                            <nav aria-label="相邻文章" class="article-neighbors">
                                {newer && (
                                    <a href={postUrl(newer.slug)} class="hover-accent">
                                        <span class="muted">上一篇</span>
                                        {newer.title}
                                    </a>
                                )}
                                {older && (
                                    <a href={postUrl(older.slug)} class="hover-accent">
                                        <span class="muted">下一篇</span>
                                        {older.title}
                                    </a>
                                )}
                            </nav>
                        )
                    )}
                </div>
                <aside class="reading-rail" aria-label="阅读辅助">
                    <div>
                        {headings.length >= 2 && (
                            <section>
                                <h2 class="t-small">文章目录</h2>
                                <ArticleToc {headings} />
                            </section>
                        )}
                        {seriesContext && (
                            <section class="reading-series">
                                <h2 class="t-small">系列目录</h2>
                                <SeriesOutline
                                    series={seriesContext.series}
                                    currentSlug={post.slug}
                                />
                            </section>
                        )}
                        <section class="reading-indicator" hidden>
                            <div>
                                <label for="reading-progress">阅读进度</label>
                                <output class="num" data-reading-percent>
                                    0%
                                </output>
                            </div>
                            <progress id="reading-progress" max="100" value="0">
                                0%
                            </progress>
                        </section>
                    </div>
                </aside>
            </div>
        </article>
    </div>
    <ShareDialog />
</SiteLayout>
<script>
    const body = document.querySelector('.article-body');
    const progress = document.querySelector<HTMLProgressElement>('#reading-progress');
    const readingLabel = document.querySelector<HTMLElement>('[data-reading-percent]');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-heading]')];
    const headings = [...new Set(links.map((link) => link.dataset.heading))].flatMap((id) => {
        const heading = id && document.getElementById(id);
        return heading ? [heading] : [];
    });
    let frame = 0;

    if (body && progress && readingLabel) {
        progress.closest<HTMLElement>('.reading-indicator')?.removeAttribute('hidden');
        const update = () => {
            const bounds = body.getBoundingClientRect();
            const traveled = window.innerHeight - bounds.top;
            const value = Math.round(Math.max(0, Math.min(1, traveled / bounds.height)) * 100);
            progress.value = value;
            readingLabel.textContent = `${value}%`;
            const active = headings.findLast(
                (heading) => heading.getBoundingClientRect().top <= 150,
            );
            for (const link of links) {
                if (active && link.dataset.heading === active.id)
                    link.setAttribute('aria-current', 'location');
                else link.removeAttribute('aria-current');
            }
            frame = 0;
        };
        const schedule = () => {
            if (!frame) frame = requestAnimationFrame(update);
        };
        update();
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule, { passive: true });
    }
</script>
