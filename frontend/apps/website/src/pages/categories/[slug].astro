---
import type { GetStaticPaths } from 'astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { listCategories, listPosts } from '../../lib/data';

export const getStaticPaths = (async () => {
    const [posts, categories] = await Promise.all([listPosts(), listCategories()]);
    return categories.flatMap((category) => {
        const entries = posts.filter((post) =>
            post.categories.some((item) => item.slug === category.slug),
        );
        return entries.length
            ? [{ params: { slug: category.slug }, props: { category, posts, entries } }]
            : [];
    });
}) satisfies GetStaticPaths;

const { category, posts, entries } = Astro.props;
---

<ArchiveLayout
    title={category.name}
    description={category.description ?? `「${category.name}」分类下的文章。`}
    {posts}
    {entries}
    category={category.slug}
/>
