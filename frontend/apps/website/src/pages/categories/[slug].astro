---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';

const content = Astro.locals.content;
const category = (await content.listCategories()).find((item) => item.slug === Astro.params.slug);
if (!category) return Astro.rewrite('/404');
const posts = await content.listPosts();
const entries = posts.filter((post) => post.categories.some((item) => item.slug === category.slug));
const series = (await content.listSeries()).filter((item) => item.category?.slug === category.slug);
---

<ArchiveLayout
    title={category.name}
    description={
        category.description ??
        (entries.length > 0
            ? `「${category.name}」分类下的文章与系列。`
            : `「${category.name}」分类下的文章系列。`)
    }
    {posts}
    {entries}
    {series}
    category={category.slug}
/>
