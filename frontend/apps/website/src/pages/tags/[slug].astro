---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';

const content = Astro.locals.content;
const tag = (await content.listTags()).find((item) => item.slug === Astro.params.slug);
if (!tag) return Astro.rewrite('/404');
const posts = await content.listPosts();
const entries = posts.filter((post) => post.tags.some((item) => item.slug === tag.slug));
---

<ArchiveLayout
    title={`#${tag.name}`}
    description={`带有「${tag.name}」标签的文章。`}
    {posts}
    {entries}
    tag={tag.slug}
/>
