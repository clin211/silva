---
import type { GetStaticPaths } from 'astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { tags, tagSlugs } from '../../data/taxonomy';
import { listPosts } from '../../lib/content';

export const getStaticPaths = (async () => {
    const posts = await listPosts();
    return tagSlugs.flatMap((slug) => {
        const entries = posts.filter((post) => post.data.tags.includes(slug));
        return entries.length ? [{ params: { slug }, props: { posts, entries } }] : [];
    });
}) satisfies GetStaticPaths;

const slug = Astro.params.slug as keyof typeof tags;
const { posts, entries } = Astro.props;
const tag = tags[slug];
---

<ArchiveLayout
    title={`#${tag}`}
    description={`带有「${tag}」标签的文章。`}
    {posts}
    {entries}
    tag={slug}
/>
