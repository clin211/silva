---
import type { GetStaticPaths } from 'astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { listPosts, listTags } from '../../lib/data';

export const getStaticPaths = (async () => {
    const [posts, tags] = await Promise.all([listPosts(), listTags()]);
    return tags.flatMap((tag) => {
        const entries = posts.filter((post) => post.tags.some((item) => item.slug === tag.slug));
        return entries.length
            ? [{ params: { slug: tag.slug }, props: { tag, posts, entries } }]
            : [];
    });
}) satisfies GetStaticPaths;

const { tag, posts, entries } = Astro.props;
---

<ArchiveLayout
    title={`#${tag.name}`}
    description={`带有「${tag.name}」标签的文章。`}
    {posts}
    {entries}
    tag={tag.slug}
/>
