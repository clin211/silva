{
    "name": "silva-frontend",
    "private": true,
    "scripts": {
        "dev": "pnpm --filter @silva/website dev",
        "dev:website": "pnpm --filter @silva/website dev",
        "dev:admin": "pnpm --filter @silva/admin dev",
        "generate:api": "pnpm --filter @silva/api-client generate",
        "check:api": "pnpm --filter @silva/api-client check",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix --deny-warnings .",
        "typecheck": "pnpm --filter @silva/api-client typecheck && pnpm --filter @silva/website check && pnpm --filter @silva/admin typecheck",
        "test": "pnpm --filter @silva/admin test",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck",
        "build": "pnpm --filter @silva/website build && pnpm --filter @silva/admin build",
        "build:website": "pnpm --filter @silva/website build",
        "build:admin": "pnpm --filter @silva/admin build",
        "preview": "pnpm --filter @silva/website preview",
        "preview:admin": "pnpm --filter @silva/admin preview"
    },
    "devDependencies": {
        "@astrojs/compiler-rs": "^0.5.3",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0"
    },
    "engines": {
        "node": ">=22.23.4"
    },
    "packageManager": "pnpm@11.9.0"
}
